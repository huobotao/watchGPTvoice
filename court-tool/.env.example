# --- 转写引擎(至少配一个) ---
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
GROQ_API_KEY=
REPLICATE_API_TOKEN=

# --- 翻译 LLM(至少配一个) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- 模型选项(可选) ---
CLAUDE_MODEL=claude-opus-4-7
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-2.5-pro

# --- 部署到云时设个口令,免得别人乱用你的 API Key ---
APP_PASSWORD=

# --- 数据目录(部署到 Render 时默认 /tmp 够用,音频会随重启清空) ---
DATA_DIR=/tmp/court-tool-data
