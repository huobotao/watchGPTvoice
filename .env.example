# --- required for AI vision analysis ---
ANTHROPIC_API_KEY=sk-ant-...

# --- data source ---
# "mock" (default) reads data/mockListings.json. Set to "domain" once you
# have a Domain.com.au developer key.
SOURCE=mock
DOMAIN_API_KEY=

# --- model + scoring ---
# claude-opus-4-7   = best quality, more expensive (default)
# claude-sonnet-4-6 = ~3x cheaper, still excellent at vision
VISION_MODEL=claude-opus-4-7

# Composite score weights (must sum to 1.0)
VISION_WEIGHT=0.5
PRICE_WEIGHT=0.5

# A listing scoring >= this threshold is flagged as a "deal"
DEAL_THRESHOLD=75

# --- server ---
PORT=3000
